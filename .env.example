# App
APP_NAME=JobEZ
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://jobez:jobez_secret@db:5432/jobez

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini (optional — leave empty to use stub AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI voice APIs
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_VOICE=alloy

# S3 uploads
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PROFILE_IMAGES_PREFIX=profile-images/
S3_RESUMES_PREFIX=resumes/
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=["http://localhost:3000"]
