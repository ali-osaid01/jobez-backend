# App
APP_NAME=JobEZ
DEBUG=false
API_V1_PREFIX=/api/v1
APP_DOMAIN=api.replace-with-elastic-ip-dashes.sslip.io
LETSENCRYPT_EMAIL=admin@example.com

# Database
POSTGRES_USER=jobez
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=jobez
DATABASE_URL=postgresql+asyncpg://jobez:replace-with-a-strong-password@postgres:5432/jobez

# JWT
JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI voice APIs
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_VOICE=alloy

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# S3 uploads
AWS_REGION=us-east-1
S3_BUCKET_NAME=replace-with-bucket-name
S3_PROFILE_IMAGES_PREFIX=profile-images/
S3_RESUMES_PREFIX=resumes/
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS='["*"]'
