{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListUploadsBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::jobez-prod-uploads-802589444367"
    },
    {
      "Sid": "ManageUploadObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::jobez-prod-uploads-802589444367/*"
    }
  ]
}
